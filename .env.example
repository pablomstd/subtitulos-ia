# Opcional: código de acceso en la URL (/t-<codigo>/manifest.json). Si se define, TODO queda privado.
ACCESS_TOKEN=
# Opcional: mejora de calidad; sin clave usa Google Translate (gtx) no oficial
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# URL HTTPS pública, sin barra final (opcional)
PUBLIC_BASE_URL=
# Configura un secreto aleatorio estable en producción/múltiples instancias.
# Sin él: usa la clave Mistral o un secreto temporal por proceso.
TOKEN_SECRET=
PORT=7111
